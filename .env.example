# Produkčné hodnoty nikdy necommitujte. Toto je iba zoznam názvov premenných.
# Voliteľné lokálne/admin nastavenia.
ADMIN_EMAILS=
EDITORIAL_FROM_EMAIL=

# Redakčné e-mailové notifikácie cez Resend. Produkčné hodnoty patria iba do Cloudflare Variables and Secrets.
RESEND_API_KEY=

# OUTREACH-1. Reálny send je defaultne vypnutý; všetky hodnoty patria do Cloudflare Variables/Secrets.
# Zapnúť až po privacy/legal kontrole, overení suppression flow a provider webhooku.
OUTREACH_SEND_ENABLED=0
OUTREACH_PROVIDER=
OUTREACH_FROM_EMAIL=
OUTREACH_WEBHOOK_SECRET=

# Notion -> Psipedia article sync. Token patrí iba do Cloudflare Secrets.
# Sync je defaultne vypnutý a vytvára/aktualizuje iba DRAFT články.
NOTION_API_TOKEN=
NOTION_ARTICLE_SYNC_ENABLED=false
NOTION_ARTICLES_DATA_SOURCE_ID=

# Notion -> Psipedia breed sync. Rovnaký token; Ready záznam vytvára/aktualizuje iba DRAFT plemeno.
NOTION_BREED_SYNC_ENABLED=false
NOTION_BREEDS_DATA_SOURCE_ID=

# Notion -> Psipedia event sync. Rovnaký token; Ready záznam vytvára/aktualizuje iba DRAFT podujatie.
NOTION_EVENT_SYNC_ENABLED=false
NOTION_EVENTS_DATA_SOURCE_ID=

# Submission/security foundation. Produkčné hodnoty nastavte ako Cloudflare secrets/vars.
# Feature flagy sú defaultne false; ak je ktorýkoľvek zapnutý, tri security secrets nižšie sú required.
TURNSTILE_SECRET_KEY=
PII_ENCRYPTION_KEY=
PII_HASH_KEY=
LOST_FOUND_SUBMISSIONS_ENABLED=false
ADOPTION_SUBMISSIONS_ENABLED=false
ORGANIZATION_SUBMISSIONS_ENABLED=false

# CI/test-only. Nepatria do production application runtime configu.
E2E_BASE_URL=
PSIPEDIA_E2E_LOCAL_BOOTSTRAP=
PSIPEDIA_ADMIN_EVENTS_E2E=

# Monetization foundation. Leave disabled/empty until a real approved publisher account exists.
PROGRAMMATIC_ADS_ENABLED=false
GOOGLE_ADSENSE_CLIENT_ID=
