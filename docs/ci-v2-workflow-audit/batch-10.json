      "file": "web-perf-observability.yml",
      "blob": "332ab00b107659fb457381ce4d3bbb924705991d",
      "events": [
        "pull_request",
        "workflow_dispatch",
        "schedule"
      ],
      "trigger": "on:\n  # Offline regression tests only; never run Chrome/Lighthouse for pull requests.\n  pull_request:\n    paths:\n      - 'scripts/web-perf-observability.mjs'\n      - 'tests/web-perf-observability.test.mjs'\n      - '.github/workflows/web-perf-observability.yml'\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'weekly: 2 URLs x 2 devices x 1; quick: 8 x 2 x 1; baseline: 8 x 2 x 3'\n        type: choice\n        required: true\n        default: quick\n        options: [weekly, quick, baseline]\n  schedule:\n    # Mondays at 04:17 UTC; bounded to four Lighthouse runs.\n    - cron: '17 4 * * 1'\n",
      "concurrency": [
        "  group: web-perf-observability-${{ github.event_name == 'pull_request' && github.event.pull_request.number || 'measure' }}",
        "  cancel-in-progress: ${{ github.event_name == 'pull_request' }}"
      ],
      "permissions": [
        "  contents: read"
      ],
      "jobs": [
        {
          "id": "offline-tests",
          "name": "Lighthouse diagnostic unit tests (no live requests)",
          "if": "github.event_name == 'pull_request'",
          "runner": "ubuntu-24.04",
          "steps": [
            {
              "name": "uses: actions/checkout@v4",
              "commands": []
            },
            {
              "name": "uses: actions/setup-node@v4",
              "commands": []
            },
            {
              "name": "run: node --test tests/web-perf-observability.test.mjs",
              "commands": []
            }
          ]
        },
        {
          "id": "measure",
          "name": "Public site measurements (not a PR check)",
          "if": "github.event_name != 'pull_request'",
          "runner": "ubuntu-24.04",
          "steps": [
            {
              "name": "name: Checkout measured source revision",
              "uses": "actions/checkout@v4",
              "commands": []
            },
            {
              "name": "name: Record source revision",
              "commands": [
                "echo \"checkout_sha=$(git rev-parse HEAD)\"",
                "test \"$(git rev-parse HEAD)\" = \"${{ github.sha }}\""
              ]
            },
            {
              "name": "name: Set up Node (no project build or npm ci)",
              "uses": "actions/setup-node@v4",
              "commands": []
            },
            {
              "name": "name: Use preinstalled Chrome",
              "commands": []
            },
            {
              "name": "name: Install pinned standalone Lighthouse only",
              "commands": []
            },
            {
              "name": "name: Verify measurement tests",
              "commands": [
                "run: node --test tests/web-perf-observability.test.mjs"
              ]
            },
            {
              "name": "name: Measure live public pages, sequentially",
              "commands": [
                "node scripts/web-perf-observability.mjs --mode \"$MEASURE_MODE\" --out reports/web-perf --bin \"$LIGHTHOUSE_BIN\""
              ]
            },
            {
              "name": "name: Upload JSON/CSV and sanitized Lighthouse HTML",
              "if": "always()",
              "uses": "actions/upload-artifact@v4",
              "commands": []
            }
          ]
        }
      ],
      "flags": {
        "remote": false,
        "write": false,
        "secrets": true,
        "local": false,
        "build": false,
        "lint": false,
        "browser": false,
        "historical": false,
        "guard": true
      },
      "disposition": "protected-review",
      "npm": [
        "npm ci"
      ],
      "tests": [
        "tests/web-perf-observability.test.mjs"
      ],
      "scripts": [
        "scripts/web-perf-observability.mjs"
      ]
    }
  ]
