        {
          "id": "services-v3-readonly",
          "name": "Inspect 0138/0139 history and schema without writes",
          "runner": "ubuntu-latest",
          "steps": [
            {
              "name": "name: Owner dispatch only; exact confirmation and main",
              "commands": [
                "input=\"$(node -e 'const e=require(process.env.GITHUB_EVENT_PATH); process.stdout.write(e.inputs?.confirmation || \"\")')\""
              ]
            },
            {
              "name": "uses: actions/checkout@v4",
              "commands": []
            },
            {
              "name": "name: Refuse stale main",
              "commands": [
                "git fetch --no-tags origin main",
                "test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/main)\""
              ]
            },
            {
              "name": "uses: actions/setup-node@v4",
              "commands": []
            },
            {
              "name": "name: Dependencies",
              "commands": [
                "run: npm ci --no-audit --no-fund"
              ]
            },
            {
              "name": "name: Offline strict SELECT and ledger/classifier regressions",
              "commands": [
                "node --test tests/services-v3-production-readonly.test.mjs",
                "npm run db:check-migrations"
              ]
            },
            {
              "name": "name: Set canonical D1 account only",
              "commands": [
                "account=\"$(node -e 'process.stdout.write(require(\"./config/cloudflare-resources.json\").account_id || \"\")')\""
              ]
            },
            {
              "name": "name: Read live 0138/0139 and sanitized service selection aggregates",
              "commands": [
                "node scripts/services-v3-production-readonly.mjs"
